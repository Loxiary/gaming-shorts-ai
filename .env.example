# Gaming Shorts AI — configuration locale
# Copier ce fichier en ".env" à la racine du projet puis adapter.
# Ne jamais mettre de clé API dans .env.example ni dans Git.

# Dossier racine des données locales (base SQLite, sources, temp, projets, exports, logs).
# Chemin absolu recommandé, sur un disque disposant d'espace libre.
GSA_DATA_DIR=D:\GamingShortsAI\data

# Serveur API local. Laisser 127.0.0.1 : l'application ne doit pas être exposée au réseau.
GSA_API_HOST=127.0.0.1
GSA_API_PORT=8000

# Origines autorisées pour le frontend (CORS), séparées par des virgules.
GSA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Niveau de logs : DEBUG, INFO, WARNING, ERROR
GSA_LOG_LEVEL=INFO

# Worker : intervalle de scrutation de la file (secondes)
GSA_WORKER_POLL_SECONDS=1.0
# Un job "running" sans battement de cœur depuis ce délai est considéré abandonné (crash) et repris.
GSA_WORKER_STALE_SECONDS=30
# Durée simulée de chaque étape du job de démonstration (secondes)
GSA_DEMO_STEP_SECONDS=2.0

# --- Import YouTube (Phase 2)
# Résolution maximale téléchargée, durée maximale acceptée, marge d'espace disque à conserver.
GSA_MAX_DOWNLOAD_HEIGHT=1080
GSA_MAX_SOURCE_MINUTES=240
GSA_MIN_FREE_DISK_GB=5
# Moteur JavaScript utilisé par yt-dlp pour YouTube (node est installé avec le frontend).
GSA_YTDLP_JS_RUNTIME=node

# --- Transcription locale faster-whisper (Phase 2)
# Modèle stocké dans GSA_DATA_DIR\models (téléchargement : python -m app.cli.models download)
GSA_WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
GSA_WHISPER_DEVICE=auto
# auto (= int8_float16 sur GPU, int8 sur CPU) | float16 | int8_float16 | int8 | float32
GSA_WHISPER_COMPUTE_TYPE=auto
# Code langue (fr, en…) ou vide pour la détection automatique
GSA_WHISPER_LANGUAGE=
# Filtre de détection de voix (réduit les hallucinations sur musique/bruit)
GSA_WHISPER_VAD=true
# 5 = plus fidèle ; 1 = nettement plus rapide (voir docs/BENCHMARK_ASR.md)
GSA_WHISPER_BEAM_SIZE=5

# --- Analyse et détection des clips (Phase 3)
# Clé API Anthropic : à renseigner UNIQUEMENT dans .env (jamais dans .env.example ni dans Git).
# Sans clé, l'analyse fonctionne en mode « signaux seuls » (gratuit, approximatif).
# ANTHROPIC_API_KEY=
GSA_LLM_MODEL=claude-sonnet-5-5
# low | medium | high : profondeur de réflexion de l'IA (coût et qualité)
GSA_LLM_EFFORT=medium
# Tarifs en $ par million de jetons, utilisés pour estimer et suivre les coûts.
GSA_LLM_PRICE_INPUT_PER_MTOK=2.0
GSA_LLM_PRICE_OUTPUT_PER_MTOK=10.0
GSA_LLM_PRICE_CACHE_READ_PER_MTOK=0.10
GSA_LLM_PRICE_CACHE_WRITE_PER_MTOK=2.50
# Plafond mensuel initial ($) ; ensuite modifiable dans Paramètres (prioritaire).
GSA_DEFAULT_MONTHLY_CAP_USD=40
# Hauteur de la copie d'analyse et nombre d'images envoyées par extrait.
GSA_ANALYSIS_PROXY_HEIGHT=480
GSA_FRAMES_PER_CANDIDATE=8

# --- Montage (Phase 4)
# Preset x264 du rendu (ultrafast … slow) : plus lent = fichier plus compact à qualité égale.
GSA_RENDER_X264_PRESET=faster
