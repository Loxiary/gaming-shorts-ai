# Gaming Shorts AI — configuration locale
# Copier ce fichier en ".env" à la racine du projet puis adapter.
# Ne jamais mettre de clé API dans .env.example ni dans Git.

# Dossier racine des données locales (base SQLite, sources, temp, projets, exports, logs).
# Chemin absolu recommandé, sur un disque disposant d'espace libre.
GSA_DATA_DIR=D:\GamingShortsAI\data

# Serveur API local. Laisser 127.0.0.1 : l'application ne doit pas être exposée au réseau.
GSA_API_HOST=127.0.0.1
GSA_API_PORT=8000

# Origines autorisées pour le frontend (CORS), séparées par des virgules.
GSA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Niveau de logs : DEBUG, INFO, WARNING, ERROR
GSA_LOG_LEVEL=INFO

# Worker : intervalle de scrutation de la file (secondes)
GSA_WORKER_POLL_SECONDS=1.0
# Un job "running" sans battement de cœur depuis ce délai est considéré abandonné (crash) et repris.
GSA_WORKER_STALE_SECONDS=30
# Durée simulée de chaque étape du job de démonstration (secondes)
GSA_DEMO_STEP_SECONDS=2.0
